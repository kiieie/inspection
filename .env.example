# Deployment environment settings — copy to .env and fill in

# Data paths
BASE_DIR=/data/inspection
RESULT_BASE_DIR=/data/results
DB_PATH=/data/robot-control-system.db
EXCEL_FILE=/data/checklist.xlsx

# VLM backend: "ollama" or "trtllm"
VLM_BACKEND=ollama

# Ollama settings (used when VLM_BACKEND=ollama)
OLLAMA_API_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen3-vl:8b

# TRT-LLM settings (used when VLM_BACKEND=trtllm)
TRTLLM_URL_4B=http://10.52.194.208:18080/qwen3_vl/4b/infer
TRTLLM_URL_8B=http://10.52.194.208:18080/qwen3_vl/8b/infer
TRTLLM_DEFAULT_MODEL=8b

# Path parsing (usually no change needed)
IMAGE_PATH_PREFIX=inspection_data
EX_PATH_PREFIX=DATA_FOR_EX
