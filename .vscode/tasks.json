{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🔥 Hot Reload Development Server",
            "type": "shell",
            "command": "watchdog",
            "args": [
                "--patterns=*.py",
                "--recursive",
                "--command='python main.py --debug'",
                "${workspaceFolder}"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            }
        },
        {
            "label": "🧹 Clean Cache & __pycache__",
            "type": "shell",
            "command": "find",
            "args": [
                "${workspaceFolder}",
                "-name", "__pycache__",
                "-type", "d",
                "-exec", "rm", "-rf", "{}", "+"
            ],
            "group": "build"
        },
        {
            "label": "📊 Performance Benchmark",
            "type": "shell",
            "command": "python",
            "args": [
                "-m", "cProfile",
                "-o", "profile_output.prof",
                "test/test_mixed_inference.py"
            ],
            "group": "test"
        }
    ]
}
