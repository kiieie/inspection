{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🔍 Debug Inspection System",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "env": {
                "INSPECTION_ENV": "development",
                "PYTHONPATH": "${workspaceFolder}",
                "INSPECTION_DEBUG": "1"
            },
            "args": ["--debug", "--hot-reload"],
            "justMyCode": false,
            "stopOnEntry": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "🧪 Run Pytest with Coverage",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": [
                "test/",
                "-v",
                "--cov=inspectors",
                "--cov=utils",
                "--cov-report=html",
                "--cov-report=term-missing"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
